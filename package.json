{
  "name": "flop-kit",
  "version": "1.1.0",
  "description": "Zero-dependency, bilingual (EN/TR) interactive CLI cockpit, activation watcher, and local Mission Control dashboard for the FLOP Network Testnet.",
  "type": "module",
  "main": "bin/flop-kit.js",
  "bin": {
    "flop-kit": "./bin/flop-kit.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node bin/flop-kit.js",
    "status": "node bin/flop-kit.js status",
    "claim": "node bin/flop-kit.js claim",
    "watch": "node bin/flop-kit.js watch",
    "doctor": "node bin/flop-kit.js doctor",
    "dashboard": "node bin/flop-kit.js dashboard",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "flop",
    "flop-labs",
    "flop-network",
    "testnet",
    "cli",
    "ai-agents",
    "validator",
    "miner",
    "tui",
    "dashboard"
  ],
  "author": "0xdead (@0Oxdead)",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xdead2026/flop-kit.git"
  },
  "homepage": "https://github.com/0xdead2026/flop-kit#readme",
  "bugs": {
    "url": "https://github.com/0xdead2026/flop-kit/issues"
  },
  "license": "MIT",
  "dependencies": {}
}
